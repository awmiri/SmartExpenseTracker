<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6">

    <!-- Fixed Header -->
    <com.example.smartexpensetracker.PersonalHeaderView
        android:id="@+id/personalHeader"
        android:layout_width="match_parent"
        android:layout_height="202dp"
        android:layout_gravity="top"
        app:personalHeaderEyebrow="HELP &amp; SUPPORT"
        app:personalHeaderTitle="How can we help?"
        app:personalHeaderSubtitle="Get help with your expense tracker" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="202dp"
        android:background="#FAF9F6"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingBottom="35dp">


            <!-- Welcome Support Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_balance_card">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_circle_question_mark"
                    android:contentDescription="Help"
                    app:tint="#E7D8B3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="How can we help?"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Find answers to your questions or get in touch with our support team."
                    android:textColor="#D0CEC5"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>

            <!-- FAQ Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="13dp"
                android:text="Frequently Asked Questions"
                android:textColor="#252923"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- FAQ 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_help_white_card">

                <LinearLayout
                    android:id="@+id/faqQuestion1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="How can I add a transaction?"
                        android:textColor="#252923"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:id="@+id/faqArrow1"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Expand answer"
                        app:tint="#285D4D"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/faqAnswer1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="You can add transactions by receiving bank messages or entering them manually."
                    android:textColor="#858A86"
                    android:textSize="11sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- FAQ 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_help_white_card">

                <LinearLayout
                    android:id="@+id/faqQuestion2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="How are bank messages detected?"
                        android:textColor="#252923"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:id="@+id/faqArrow2"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Expand answer"
                        app:tint="#285D4D"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/faqAnswer2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="The app can detect supported bank SMS messages after you grant the required permission."
                    android:textColor="#858A86"
                    android:textSize="11sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- FAQ 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_help_white_card">

                <LinearLayout
                    android:id="@+id/faqQuestion3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="How can I change a category?"
                        android:textColor="#252923"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:id="@+id/faqArrow3"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Expand answer"
                        app:tint="#285D4D"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/faqAnswer3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Open the transaction details and select the category you want."
                    android:textColor="#858A86"
                    android:textSize="11sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Contact Us -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Us"
                android:textColor="#252923"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_white_card"
                android:padding="16dp">

                <!-- Email -->
                <LinearLayout
                    android:id="@+id/rowEmailSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_help_icon"
                        android:src="@drawable/ic_profile"
                        app:tint="#285D4D" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email Support"
                            android:textColor="#252923"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="support@smartexpense.app"
                            android:textColor="#858A86"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="#858A86"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0EA"/>

                <!-- Phone -->
                <LinearLayout
                    android:id="@+id/rowPhoneSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_help_icon"
                        android:src="@drawable/ic_profile"
                        app:tint="#285D4D"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Call Us"
                            android:textColor="#252923"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1 202 555 0148"
                            android:textColor="#858A86"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="#858A86"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0EA"/>

                <!-- Support Hours -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_help_icon"
                        android:src="@drawable/ic_circle_question_mark"
                        app:tint="#285D4D"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Support Hours"
                            android:textColor="#252923"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monday - Friday · 9 AM - 5 PM"
                            android:textColor="#858A86"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>


