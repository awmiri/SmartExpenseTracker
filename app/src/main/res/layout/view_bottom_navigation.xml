<?xml version="1.0" encoding="utf-8"?>
<!-- Floating navigation bar -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigationContainer"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_gravity="bottom"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="25dp"
    android:background="@drawable/bg_glass_nav"
    android:elevation="10dp">

    <LinearLayout
        android:id="@+id/navigationTabs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="4dp">

        <!-- Transactions -->
        <LinearLayout
            android:id="@+id/tabTransaction"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconTransaction"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_transactions"
                app:tint="#858585"
                android:contentDescription="Transactions" />

        </LinearLayout>

        <!-- Categories -->
        <LinearLayout
            android:id="@+id/tabCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconCategory"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_categories"
                app:tint="#858585"
                android:contentDescription="Categories" />

        </LinearLayout>

        <!-- Home -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="#111111"
                android:contentDescription="Home" />

        </LinearLayout>

        <!-- Analytics -->
        <LinearLayout
            android:id="@+id/tabAnalytics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconAnalytics"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_analytics"
                app:tint="#858585"
                android:contentDescription="Analytics" />

        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile"
                app:tint="#858585"
                android:contentDescription="Profile" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

