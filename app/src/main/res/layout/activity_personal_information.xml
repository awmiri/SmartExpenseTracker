<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PersonalInformationActivity">

    <FrameLayout
        android:id="@+id/mainPersonalInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF9F6">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- Premium Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="202dp"
                    android:background="@drawable/bg_personal_header"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="24dp">

                    <!-- Top Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="18sp">

                        <LinearLayout
                            android:id="@+id/btnBack"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_personal_back"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="34sp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Back"
                                android:src="@drawable/ic_chevron_left"
                                app:tint="#FFFFFF" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.16"
                            android:text="ACCOUNT SETTINGS"
                            android:textColor="#D1E1D7"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Header Content -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_personal_avatar"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="27sp"
                            android:textStyle="bold">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_profile"
                                app:tint="#ffff" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Personal Details"
                                android:textColor="#FFFFFF"
                                android:textSize="23sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Manage your personal information"
                                android:textColor="#D1E1D7"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>


                </LinearLayout>

                <!-- Form Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="25dp"
                    android:orientation="vertical">

                    <!-- Section Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Basic Information"
                            android:textColor="#252923"
                            android:textSize="19sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EDITABLE"
                            android:textColor="#285D4D"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Make sure your details are always up to date."
                        android:textColor="#92978F"
                        android:textSize="12sp"/>

                    <!-- Full Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="FULL NAME"
                        android:textColor="#727B73"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"/>

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="9dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_personal_input"
                        android:hint="Enter your full name"
                        android:textColor="#252923"
                        android:textColorHint="#A7ADA5"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:inputType="textPersonName"
                        android:fontFamily="sans"/>

                    <!-- Phone -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="23dp"
                        android:text="PHONE NUMBER"
                        android:textColor="#727B73"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"/>

                    <EditText
                        android:id="@+id/etPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="9dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_personal_input"
                        android:hint="Enter your phone number"
                        android:textColor="#252923"
                        android:textColorHint="#A7ADA5"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:inputType="phone"
                        android:fontFamily="sans"/>

                    <!-- Security Note -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="15dp"
                        android:background="@drawable/bg_personal_note">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="i"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#285D4D"
                            android:background="@drawable/bg_personal_info_icon"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Changing your phone number may require verification with a confirmation code."
                            android:textColor="#64776A"
                            android:textSize="11sp"
                            android:lineSpacingExtra="3dp"/>

                    </LinearLayout>

                    <!-- Save Button -->
                    <TextView
                        android:id="@+id/btnSaveChanges"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="30dp"
                        android:gravity="center"
                        android:text="Save Changes"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_personal_save"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:gravity="center"
                        android:text="YOUR INFORMATION IS SECURE"
                        android:textColor="#A0A69E"
                        android:textSize="9sp"
                        android:letterSpacing="0.14"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>