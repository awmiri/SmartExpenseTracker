<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:paddingTop="55dp"
        android:paddingBottom="30dp">

        <!-- Logo -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_login_logo">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_wallet"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Smart Wallet"
            android:textColor="#252923"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Your money, your control."
            android:textColor="#858A86"
            android:textSize="13sp" />

        <!-- Login Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_login_card">

            <!-- Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textColor="#252923"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Enter your details to continue"
                android:textColor="#858A86"
                android:textSize="13sp" />

            <!-- Phone Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Phone Number"
                android:textColor="#252923"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Phone Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:background="@drawable/bg_login_input">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_phone"
                    app:tint="#285D4D" />

                <EditText
                    android:id="@+id/phoneInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Enter your phone number"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:textColor="#252923"
                    android:textColorHint="#B8BBB9"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Password Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Password"
                android:textColor="#252923"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Password Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:background="@drawable/bg_login_input">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#285D4D" />

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Enter your password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="#252923"
                    android:textColorHint="#B8BBB9"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Continue Button -->
            <TextView
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="27dp"
                android:background="@drawable/bg_login_button"
                android:gravity="center"
                android:text="Continue"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Auto Register Hint -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:gravity="center"
                android:text="New here? Your account will be created automatically."
                android:textColor="#858A86"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:letterSpacing="0.15"
            android:text="SMART EXPENSE TRACKER"
            android:textColor="#A4A8A2"
            android:textSize="10sp" />

    </LinearLayout>

</ScrollView>