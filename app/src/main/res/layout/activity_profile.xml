<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="20dp"
    android:background="#FAF9F6">

    <!--  main content  -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF9F6"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingBottom="120dp"
            >

            <!-- user profile pic  -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center">
                <!-- image profile -->
                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_default_avatar"
                    android:scaleType="centerCrop"
                    android:contentDescription="Profile picture" />

                <!-- camera icon -->
                <ImageView
                    android:id="@+id/profPic_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_glass_nav"
                    android:padding="7dp"
                    android:src="@drawable/ic_camera"
                    android:scaleType="fitCenter"
                    android:contentDescription="Change profile picture" />
            </FrameLayout>

            <!-- username & user email  -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="22sp"
                    android:text="Ali Rezaaei"
                    android:textStyle="bold"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:layout_marginTop="4dp"
                    android:text="ali.rezaei@example.com "
                    />

            </LinearLayout>

            <!-- short info about my account  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_profile_more_info_bg"
                android:padding="12dp"
                >
                <!-- total container counter -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    >
                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_wallet"
                        app:tint="#285D4D"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textSize="17dp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"

                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Container"
                        android:textSize="10dp"
                        android:layout_marginTop="2dp"
                        android:textColor="#6c757d"
                        />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="45dp"
                    android:background="#adb5bd" />

                <!-- total income content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    >
                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_hand_coins"

                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$2,450"
                        android:textSize="17dp"
                        android:layout_marginTop="2dp"
                        android:textStyle="bold"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Income"
                        android:textSize="10dp"
                        android:layout_marginTop="2dp"
                        android:textColor="#6c757d"
                        />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="45dp"
                    android:background="#adb5bd" />

                <!-- totoal expense content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_wallet_minimal"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$1,280"
                        android:textSize="17dp"
                        android:layout_marginTop="2dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Expense"
                        android:layout_marginTop="2dp"
                        android:textColor="#6c757d"
                        android:textSize="10dp" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="45dp"
                    android:background="#adb5bd" />

                <!-- new balance content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    >
                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_trending_up"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$1,200"
                        android:textSize="17dp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Net Balance"
                        android:textSize="10dp"
                        android:layout_marginTop="2dp"
                        android:textColor="#6c757d"
                        />
                </LinearLayout>
            </LinearLayout>

            <!-- logout brn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:background="@drawable/profile_logout_btn"
                >
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_log_out"
                    app:tint="#dd1c1a"
                    android:layout_marginRight="10dp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log Out"
                    android:textStyle="bold"
                    android:textSize="18dp"
                    android:textColor="#dd1c1a"
                    />

            </LinearLayout>

        </LinearLayout>


    </ScrollView>

    <!-- Floating navigation bar -->
    <include
        layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="25dp"
        android:layout_height="60dp" />

</FrameLayout>
